# Netlify 서버 함수(netlify/functions/guestbook.mjs)에서 사용하는 환경변수.
# 실제 값은 Netlify 대시보드의 Site settings > Environment variables 에 입력한다.
# 이 파일은 "예시"이며, 실제 .env 파일은 .gitignore 로 커밋에서 제외된다.
# SERVICE ROLE 키는 절대로 브라우저 JS나 공개 저장소에 넣지 않는다.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
